    {
      "parameters": {
        "jsCode": "const text = $json.body.text.toLowerCase();\nlet category, priority, note = null;\nconst churnSignals = ['cancel', 'competitor', 'evaluating alternatives', 'moving to'];\nconst billingSignals = ['charge', 'invoice', 'billed', 'refund', 'billing'];\nconst bugSignals = ['crash', 'broken', 'error', 'fails', 'bug', 'won\\'t load', 'stuck'];\nconst howtoSignals = ['how do i', 'how to', 'what is', \"what's the difference\"];\nconst isChurn = churnSignals.some(s => text.includes(s));\nconst isBilling = billingSignals.some(s => text.includes(s));\nconst isBug = bugSignals.some(s => text.includes(s));\nconst isHowto = howtoSignals.some(s => text.includes(s));\nconst matchCount = [isChurn, isBilling, isBug, isHowto].filter(Boolean).length;\nif (matchCount === 0 || matchCount > 1 && !isChurn) {\n  category = 'needs-human-review';\n  priority = 'n/a';\n  note = 'Ambiguous or no clear category signal — mocked logic, needs human judgment';\n} else if (isChurn) {\n  category = 'churn-risk';\n  priority = 'high';\n} else if (isBug) {\n  // bug is high by default (bug tickets have the worst resolution rate\n  // in this dataset). Downgrade to medium/minor only for cosmetic issues\n  // with no functional impact.\n  const isMinorCosmetic = text.includes('color') || text.includes('spacing') || text.includes('text') || text.includes('alignment');\n  category = isMinorCosmetic ? 'bug-minor' : 'bug-severe';\n  priority = isMinorCosmetic ? 'medium' : 'high';\n  note = isMinorCosmetic ? null : 'Severe bug: routed to human review rather than auto-drafted.';\n} else if (isBilling) {\n  category = 'billing';\n  priority = (text.includes('duplicate') || text.includes('twice') || text.includes('again')) ? 'high' : 'medium';\n} else {\n  category = 'how-to';\n  priority = 'low';\n}\nconst drafts = {\n  billing: `We're looking into the charge on your account and will follow up with a breakdown.`,\n  'bug-minor': `Thanks for flagging this - we've noted the issue and it will be reviewed by our team.`,\n  'bug-severe': `We're sorry for the trouble - this has been flagged for our engineering team.`,\n  'how-to': `Here's how to do that - check our help docs for step-by-step instructions.`,\n  'churn-risk': `We don't want to lose you - someone from our team will reach out personally.`\n};\nconst suggested_response_draft = drafts[category] || null;\nreturn {\n  json: {\n    id: $json.body.id || null,\n    text: $json.body.text,\n    category,\n    priority,\n    note,\n    suggested_response_draft\n  }\n};"
      },
